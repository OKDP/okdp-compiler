# --published <dir>: what the instances compiled into <dir>/<release>/
# publish; a reference may name one of their outputs, here the database
# server demo-pg publishes, of another name than the instance's: on stderr,
# the output after the contract. The compiled release's own, demo-app, is
# left out: else two instances would publish it.
status 0 okdp-compile --package $WORK/app --contracts $WORK/contracts --published $WORK/instances --release demo-app --namespace demo -f $WORK/config.yaml -o $WORK/out
! stdout .
cmp stderr $WORK/depends.txt
cmp $WORK/out/instance.values.yaml $WORK/values.txt

# Without it, no output is known: status 1, nothing written.
status 1 okdp-compile --package $WORK/app --contracts $WORK/contracts --release demo-app --namespace demo -f $WORK/config.yaml -o $WORK/none
stderr '^error: db: "demo-pg-hive" is not a connection, and the server contract has no internal naming convention$'
! exists $WORK/none

-- depends.txt --
depends on demo-pg (server demo-pg-hive, db)
-- values.txt --
# Code generated by okdp-compile. DO NOT EDIT.
app:
  credentials: demo-pg-hive-app
  from: output of demo-pg
  host: demo-pg-rw.demo.svc:5433
-- config.yaml --
db: demo-pg-hive
-- app/Chart.yaml --
apiVersion: v2
name: app
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- app/config.schema.json --
{"properties": {"db": {"type": "string", "x-okdp-connection-ref": {"contract": "server"}}}}
-- app/values.cel.yaml --
app:
  host: ${{ values.db.host }}:${{ str(values.db.port) }}
  credentials: ${{ values.db.secretRef.name }}
  from: ${{ values.db.okdp.source }} of ${{ values.db.okdp.instance }}
-- contracts/server.schema.json --
{"properties": {"host": {"type": "string"}, "port": {"type": "integer", "default": 5432}}, "required": ["host"]}
-- instances/demo-pg/okdp.instance.yaml --
provides:
  - name: demo-pg-hive
    contract: server
    values:
      host: demo-pg-rw.demo.svc
      port: 5433
    secretRef:
      name: demo-pg-hive-app
-- instances/demo-app/okdp.instance.yaml --
provides:
  - name: demo-pg-hive
    contract: server
    values:
      host: demo-app.demo.svc
