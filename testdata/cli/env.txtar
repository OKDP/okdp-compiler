# --charts and --contracts: required, by flag or variable.
status 1 okdp-compile --package examples/02_advanced/input/service --release demo-webapp --namespace demo --platform examples/02_advanced/input/platform.yaml
stderr '^error: --charts \(or \$OKDP_CHARTS\) is required$'
env OKDP_CHARTS=examples/02_advanced/input/charts
status 1 okdp-compile --package examples/02_advanced/input/service --release demo-webapp --namespace demo --platform examples/02_advanced/input/platform.yaml
stderr '^error: --contracts \(or \$OKDP_CONTRACTS\) is required$'

# $OKDP_CHARTS and $OKDP_CONTRACTS stand for them.
env OKDP_CONTRACTS=examples/02_advanced/input/contracts
status 0 okdp-compile --package examples/02_advanced/input/service --release demo-webapp --namespace demo --platform examples/02_advanced/input/platform.yaml

# The flags win over the variables.
env OKDP_CHARTS=examples/02_advanced/input/platform.yaml OKDP_CONTRACTS=examples/02_advanced/input/platform.yaml
status 1 okdp-compile --package examples/02_advanced/input/service --release demo-webapp --namespace demo --platform examples/02_advanced/input/platform.yaml
stderr '^error: --charts examples/02_advanced/input/platform.yaml: not a directory$'
status 0 okdp-compile --package examples/02_advanced/input/service --charts examples/02_advanced/input/charts --contracts examples/02_advanced/input/contracts --release demo-webapp --namespace demo --platform examples/02_advanced/input/platform.yaml
