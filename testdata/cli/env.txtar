# --charts and --contracts: required, by flag or variable.
status 1 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out
stderr '^error: --charts \(or \$OKDP_CHARTS\) is required$'
env OKDP_CHARTS=examples/02_advanced/.charts
status 1 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out
stderr '^error: --contracts \(or \$OKDP_CONTRACTS\) is required$'

# $OKDP_CHARTS and $OKDP_CONTRACTS stand for them.
env OKDP_CONTRACTS=examples/02_advanced/input/db/contracts
status 0 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out

# The flags win over the variables.
env OKDP_CHARTS=examples/02_advanced/input/db/platform.yaml OKDP_CONTRACTS=examples/02_advanced/input/db/platform.yaml
status 1 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out
stderr '^error: .*http.schema.json: not a directory$'
status 0 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --charts examples/02_advanced/.charts --contracts examples/02_advanced/input/db/contracts --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out
