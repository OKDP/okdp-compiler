# --contracts: needed by a contract read, here that of the connection the
# instance provides. A compile reads no chart: $OKDP_CHARTS, a file here,
# is not read.
env OKDP_CHARTS=examples/02_advanced/input/db/platform.yaml
status 1 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out
stderr '^error: provides "demo-webapp" \(http\): the http contract cannot be read: http.schema.json: no contracts directory: give --contracts \(or \$OKDP_CONTRACTS\)$'
! exists $WORK/out

# $OKDP_CONTRACTS stands for it.
env OKDP_CONTRACTS=examples/02_advanced/input/db/contracts
status 0 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out

# With --check, $OKDP_CHARTS stands for --charts: a file fails at the
# first chart read.
env OKDP_CONTRACTS=examples/03_full/input/db/contracts
status 1 okdp-compile --check --package examples/03_full/input/db/catalog/workspace/3.2.0-1.4.0 --release demo-workspace --namespace demo --context examples/03_full/input/db/platform.yaml --context 1:examples/03_full/input/db/projects/demo/project.yaml --context 2:examples/03_full/input/db/projects/demo/instances/demo-workspace/connections.yaml -f examples/03_full/input/db/projects/demo/instances/demo-workspace/config.yaml
stderr '^error: api: stat charts.example.org/workspace-3.2.0/workspace: not a directory$'

# The flags win over the variables.
status 0 okdp-compile --check --charts examples/03_full/.charts --package examples/03_full/input/db/catalog/workspace/3.2.0-1.4.0 --release demo-workspace --namespace demo --context examples/03_full/input/db/platform.yaml --context 1:examples/03_full/input/db/projects/demo/project.yaml --context 2:examples/03_full/input/db/projects/demo/instances/demo-workspace/connections.yaml -f examples/03_full/input/db/projects/demo/instances/demo-workspace/config.yaml
env OKDP_CONTRACTS=examples/02_advanced/input/db/platform.yaml
status 1 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out2
stderr '^error: .*http.schema.json: not a directory$'
status 0 okdp-compile --package examples/02_advanced/input/db/catalog/webapp/1.0.0 --contracts examples/02_advanced/input/db/contracts --release demo-webapp --namespace demo --context examples/02_advanced/input/db/platform.yaml -o $WORK/out2
