# With --check, $OKDP_CHARTS stands for --charts: a file fails at the first
# chart read, and --charts wins over it. Without --check, it is not read: a
# compile reads no chart.
env OKDP_CHARTS=examples/02_advanced/input/db/platform.yaml
status 0 okdp-compile --repository examples/02_advanced/input/db -o $WORK/out
status 1 okdp-compile --check --repository examples/03_full/input/db
stderr '^error: demo/demo-db: postgresql: stat charts.example.org/postgresql-16.0.0/postgresql: not a directory$'
status 0 okdp-compile --check --charts examples/03_full/.charts --repository examples/03_full/input/db
