# --charts and --contracts: required, by flag or variable.
status 1 okdp-compile --package example/input/package --release demo-webapp --namespace demo --platform example/input/platform.yaml
stderr '^error: --charts \(or \$OKDP_CHARTS\) is required$'
env OKDP_CHARTS=example/input/charts
status 1 okdp-compile --package example/input/package --release demo-webapp --namespace demo --platform example/input/platform.yaml
stderr '^error: --contracts \(or \$OKDP_CONTRACTS\) is required$'

# $OKDP_CHARTS and $OKDP_CONTRACTS stand for them.
env OKDP_CONTRACTS=example/input/contracts
status 0 okdp-compile --package example/input/package --release demo-webapp --namespace demo --platform example/input/platform.yaml

# The flags win over the variables.
env OKDP_CHARTS=example/input/platform.yaml OKDP_CONTRACTS=example/input/platform.yaml
status 1 okdp-compile --package example/input/package --release demo-webapp --namespace demo --platform example/input/platform.yaml
stderr '^error: --charts example/input/platform.yaml: not a directory$'
status 0 okdp-compile --package example/input/package --charts example/input/charts --contracts example/input/contracts --release demo-webapp --namespace demo --platform example/input/platform.yaml
