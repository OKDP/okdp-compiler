# Credentials in clear are refused (Inputs.AllowPlainSecrets), whatever
# the project: a Secret of the objects section with values, and the
# Secret of a provides item without generate; --allow-plain-secrets
# accepts them, for a deployments repository that is private. The objects
# file is committed: credentials are generated in the cluster
# (okdpGeneratedSecret, generate) or read from the platform's secret
# store.
status 1 okdp-compile --repository $WORK/plain -o $WORK/files
! stdout .
stderr '^error: demo/demo-web: web: objects: Secret/demo-web-token: a plain value \(stringData\): .*Inputs.AllowPlainSecrets allows it$'
! exists $WORK/files

status 1 okdp-compile --repository $WORK/provides -o $WORK/files
! stdout .
stderr '^error: demo/demo-web: web: output "web": secret: a plain value \(stringData\): credentials are generated \(generate\) or read from the platform''s secret store; Inputs.AllowPlainSecrets allows it$'
! exists $WORK/files

status 0 okdp-compile --repository $WORK/plain -o $WORK/files --allow-plain-secrets
! stdout .
grep 'token: changeme' $WORK/files/projects/demo/instances/demo-web/okdp.objects.yaml

-- plain/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- plain/catalog/web/1.0.0/okdp.yaml --
objects:
  - apiVersion: v1
    kind: Secret
    metadata: {name: '${{ release.name }}-token', labels: '${{ labels }}'}
    stringData: {token: changeme}
-- plain/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
-- provides/contracts/api.schema.json --
{"properties": {"url": {"type": "string"}, "token": {"type": "string", "x-okdp-secret": true}}, "required": ["url"]}
-- provides/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- provides/catalog/web/1.0.0/okdp.yaml --
provides:
  - contract: api
    values: {url: https://web.example.org}
    secret: {stringData: {token: changeme}}
-- provides/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
