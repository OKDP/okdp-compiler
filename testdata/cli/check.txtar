# --check: the tree compiled and checked, nothing written: status 0, the
# bindings printed, no dependency. With --charts (or $OKDP_CHARTS, read
# with --check only), the final values are checked against the upstream
# charts too.
status 0 okdp-compile --check --repository examples/03_full/input/db
! stdout .
cmp stderr $WORK/bound.txt
status 0 okdp-compile --check --charts examples/03_full/.charts --repository examples/03_full/input/db
! stdout .
cmp stderr $WORK/bound.txt

# A value the chart's values.schema.json refuses: compiled, and checked
# without the chart; with it, status 1, the report on stderr.
status 0 okdp-compile --check --repository $WORK/lib --repository $WORK/bad
env OKDP_CHARTS=$WORK/charts
status 1 okdp-compile --check --repository $WORK/lib --repository $WORK/bad
! stdout .
cmp stderr $WORK/schema.txt

# An instance list appended to (append) where the chart's default list has
# items the final list lacks: Helm replaces the chart's list. A warning,
# status 0; none without the chart, nor once the package restates them.
status 0 okdp-compile --check --repository $WORK/lib --repository $WORK/tree
! stdout .
cmp stderr $WORK/warning.txt
env OKDP_CHARTS=
status 0 okdp-compile --repository $WORK/lib --repository $WORK/tree -o $WORK/files
! stderr .
grep '^  args:\n    - --debug\n' $WORK/files/projects/demo/instances/demo-hello/instance.values.yaml
cp $WORK/restated.yaml $WORK/lib/catalog/hello/1.0.0/values.yaml
status 0 okdp-compile --check --charts $WORK/charts --repository $WORK/lib --repository $WORK/tree
! stderr .

# --check with --output, --charts without --check: status 1, nothing
# written.
status 1 okdp-compile --check --repository $WORK/lib --repository $WORK/tree -o $WORK/check
stderr '^error: --check writes nothing: no --output \(-o\)$'
! exists $WORK/check
status 1 okdp-compile --charts $WORK/charts --repository $WORK/lib --repository $WORK/tree -o $WORK/charted
stderr '^error: --charts is read by --check only: a compile reads no chart$'
! exists $WORK/charted

-- bound.txt --
demo/demo-workspace: catalogs[1].database: claim demo.marketing (database) bound to demo/demo-db, the default class standard
demo/demo-workspace: database: claim demo.demo-workspace.database (database) bound to demo/demo-db, the default class standard
-- schema.txt --
error: demo/demo-bad: compiled values don't meet the specifications of the schema(s) in the following chart(s):
hello (hello-1.0.0):
- at '/message': got number, want string
-- warning.txt --
warning: demo/demo-hello: upstream.hello.args: appended to the package's list, not to the default list of hello-1.0.0, which Helm replaces: the final list lacks all its items; restate them in the package's values of hello (its defaults or values file) to keep them
-- lib/catalog/hello/1.0.0/Chart.yaml --
apiVersion: v2
name: hello
version: 1.0.0
dependencies:
  - {name: hello, repository: https://charts.example.org, version: 1.0.0}
-- lib/catalog/hello/1.0.0/okdp.yaml --
upstream:
  hello: {append: [args]}
-- lib/catalog/hello/1.0.0/values.yaml --
hello:
  message: Hello
-- restated.yaml --
hello:
  message: Hello
  args: [--verbose]
-- tree/projects/demo/instances/demo-hello/instance.yaml --
service: hello
version: 1.0.0
-- tree/projects/demo/instances/demo-hello/config.yaml --
upstream:
  hello:
    args: [--debug]
-- bad/projects/demo/instances/demo-bad/instance.yaml --
service: hello
version: 1.0.0
-- bad/projects/demo/instances/demo-bad/config.yaml --
upstream:
  hello:
    message: 1
    args: [--verbose]
-- charts/charts.example.org/hello-1.0.0/hello/values.yaml --
message: Hi
args: [--verbose]
-- charts/charts.example.org/hello-1.0.0/hello/values.schema.json --
{"properties": {"message": {"type": "string"}}}
