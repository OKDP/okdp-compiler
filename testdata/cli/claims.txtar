# Claims: demo-app claims a server connection of its own, demo-b and
# demo-c reference the named claim of their project, reports; data/pg,
# the provider of the platform's default class of server connections,
# standard, provisions them, compiled first. Each binding on stderr, then,
# the files written, the dependencies, across namespaces.
status 0 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/tree -o $WORK/out
! stdout .
cmp stderr $WORK/stderr.txt
cmp $WORK/out/projects/data/instances/pg/okdp.info.yaml $WORK/info.txt
cmp $WORK/out/projects/demo/instances/demo-app/instance.values.yaml $WORK/values.txt

# Flux: demo-app's HelmRelease waits for pg's, of another namespace.
status 0 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/tree -o $WORK/flux --target flux
grep -count=1 'name: "pg"' $WORK/flux/projects/demo/instances/demo-app/helmrelease.yaml

# A second provider: the claims stay with the default class's.
status 0 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/tree --repository $WORK/second -o $WORK/second-out
cmp stderr $WORK/stderr.txt

# No default class: a claim that names neither a class nor a provider is
# refused, the classes said; nothing written.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/tree --repository $WORK/second -o $WORK/none
stderr '^error: demo/demo-app: claims.reports: claim \(server\): it names no class, and the context sets no default one, global.okdp.provisioning.server.default \(Inputs.Context\): no class of server connections is defined \(global.okdp.provisioning.server.classes\)$'
stderr '^db: claim \(server\): it names no class, and the context sets no default one, global.okdp.provisioning.server.default \(Inputs.Context\): no class of server connections is defined \(global.okdp.provisioning.server.classes\)$'
! exists $WORK/none

# A requirement the default class's provider does not meet: the claimer
# is refused, its claim not moved to the provider that meets it; nothing
# written. Named, that provider binds it, and so does a class of the
# project's, named.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/tree --repository $WORK/second --repository $WORK/strict -o $WORK/strict-out
stderr '^error: reports/strict: db \(claim "reports.strict.db" of data/pg\): the connection does not meet the package''s requirement \(x-okdp-connection-ref.require\); data/pg is the provider of the default class standard of server connections \(global.okdp.provisioning.server.default\): name a class whose provider meets it \(class\), or change the default:$'
stderr '^- at ''/host'': ''pg-rw.data.svc'' does not match pattern ''\^pg2-''$'
! exists $WORK/strict-out
status 0 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/tree --repository $WORK/second --repository $WORK/named -o $WORK/named-out
stderr '^reports/strict: db: claim reports.strict.db \(server\) bound to data2/pg2$'
status 0 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/tree --repository $WORK/second --repository $WORK/classes -o $WORK/classes-out
stderr '^reports/strict: db: claim reports.strict.db \(server\) bound to data2/pg2, class second$'

# A request the contract's claim schema refuses (x-okdp-claim): the
# claimer is refused when it binds, every violation said; nothing
# written.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/tree --repository $WORK/big -o $WORK/big-out
stderr '^error: reports/big: db: claim \(server\): the request does not meet the contract''s claim schema \(x-okdp-claim\):$'
stderr '^- at ''/size'': ''5G'' does not match pattern ''\^\[0-9\]\+Gi\$''$'
! exists $WORK/big-out

-- stderr.txt --
demo/demo-app: db: claim demo.demo-app.db (server) bound to data/pg, the default class standard
demo/demo-b: db: claim demo.reports (server) bound to data/pg, the default class standard
demo/demo-c: db: claim demo.reports (server) bound to data/pg, the default class standard
demo/demo-app: depends on data/pg (server demo.demo-app.db, db)
demo/demo-b: depends on data/pg (server demo.reports, db)
demo/demo-c: depends on data/pg (server demo.reports, db)
-- info.txt --
provides:
  - name: demo.demo-app.db
    contract: server
    values:
      host: pg-rw.data.svc
      name: demo.demo-app.db
  - name: demo.reports
    contract: server
    values:
      host: pg-rw.data.svc
      name: demo.reports
-- values.txt --
# Code generated by okdp-compile. DO NOT EDIT.
app:
  db: pg-rw.data.svc/demo.demo-app.db
  global:
    okdp:
      provisioning:
        server:
          classes:
            standard:
              provider: data/pg
          default: standard
-- lib/contracts/server.schema.json --
{"properties": {"host": {"type": "string"}, "name": {"type": "string"}}, "required": ["host"],
 "x-okdp-claim": {"properties": {"size": {"type": "string", "pattern": "^[0-9]+Gi$"}}, "additionalProperties": false}}
-- lib/catalog/pg/1.0.0/Chart.yaml --
apiVersion: v2
name: pg
version: 1.0.0
dependencies:
  - {name: postgresql, repository: https://charts.example.org, version: 1.0.0}
-- lib/catalog/pg/1.0.0/okdp.yaml --
provisions: [server]
provides:
  - $for: c in claims
    $each: {contract: server, name: '${{ c.id }}', values: {host: '${{ release.name }}-rw.${{ release.namespace }}.svc', name: '${{ c.id }}'}}
-- lib/catalog/app/1.0.0/Chart.yaml --
apiVersion: v2
name: app
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- lib/catalog/app/1.0.0/config.schema.json --
{"properties": {"db": {"type": ["string", "object"], "default": {}, "x-okdp-connection-ref": {"contract": "server", "provision": true}}}}
-- lib/catalog/app/1.0.0/values.cel.yaml --
app:
  db: ${{ values.db.host }}/${{ values.db.name }}
-- lib/catalog/strict/1.0.0/Chart.yaml --
apiVersion: v2
name: strict
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- lib/catalog/strict/1.0.0/config.schema.json --
{"properties": {"db": {"type": ["string", "object"], "default": {}, "x-okdp-connection-ref": {"contract": "server", "provision": true, "require": {"properties": {"host": {"pattern": "^pg2-"}}}}}}}
-- lib/catalog/strict/1.0.0/values.cel.yaml --
app:
  db: ${{ values.db.host }}
-- platform/platform.yaml --
global:
  okdp:
    provisioning:
      server:
        default: standard
        classes:
          standard: {provider: data/pg}
-- tree/projects/data/instances/pg/instance.yaml --
service: pg
version: 1.0.0
-- tree/projects/demo/instances/demo-app/instance.yaml --
service: app
version: 1.0.0
-- tree/projects/demo/instances/demo-b/instance.yaml --
service: app
version: 1.0.0
-- tree/projects/demo/project.yaml --
claims:
  reports: {contract: server}
-- tree/projects/demo/instances/demo-b/config.yaml --
db: reports
-- tree/projects/demo/instances/demo-c/instance.yaml --
service: app
version: 1.0.0
-- tree/projects/demo/instances/demo-c/config.yaml --
db: reports
-- second/projects/data2/instances/pg2/instance.yaml --
service: pg
version: 1.0.0
-- strict/projects/reports/instances/strict/instance.yaml --
service: strict
version: 1.0.0
-- named/projects/reports/instances/strict/instance.yaml --
service: strict
version: 1.0.0
-- big/projects/reports/instances/big/instance.yaml --
service: app
version: 1.0.0
-- big/projects/reports/instances/big/config.yaml --
db: {request: {size: 5G}}
-- classes/projects/reports/project.yaml --
global:
  okdp:
    provisioning:
      server:
        classes:
          second: {provider: data2/pg2}
-- classes/projects/reports/instances/strict/instance.yaml --
service: strict
version: 1.0.0
-- classes/projects/reports/instances/strict/config.yaml --
db: {class: second}
-- named/projects/reports/instances/strict/config.yaml --
db: {provider: data2/pg2}
