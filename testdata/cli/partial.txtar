# --partial: a refused instance fails its project, not the tree. First,
# every instance compiles, with --target flux.
status 0 okdp-compile --repository $WORK/tree -o $WORK/out --target flux
cp $WORK/out/projects/demo/instances/demo-web/instance.values.yaml $WORK/web-before.yaml

# demo-web refused, data-db changed: without --partial, nothing written.
cp $WORK/zero.yaml $WORK/tree/projects/demo/instances/web/config.yaml
cp $WORK/three.yaml $WORK/tree/projects/data/instances/db/config.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux
! grep 'replicas: 3' $WORK/out/projects/data/instances/data-db/instance.values.yaml

# With it: data written, demo kept as the output has it (demo-ok, which
# compiles, not written either), the root Kustomization listing both;
# each refusal printed, then the project not written; status 1.
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial --report $WORK/report.json
! stdout .
stderr '^error: demo/demo-web: values don''t meet'
stderr '^error: demo: not written, an instance of it refused \(--partial\): .*out/projects/demo/ kept as it is$'
grep 'replicas: 3' $WORK/out/projects/data/instances/data-db/instance.values.yaml
cmp $WORK/out/projects/demo/instances/demo-web/instance.values.yaml $WORK/web-before.yaml
exists $WORK/out/projects/demo/instances/demo-ok/helmrelease.yaml $WORK/out/projects/demo/project/namespace.yaml
cmp $WORK/out/projects/kustomization.yaml $WORK/root.yaml
grep -count=1 '"status": "refused"' $WORK/report.json
grep -count=1 '"status": "skipped"' $WORK/report.json
grep -count=1 '"status": "compiled"' $WORK/report.json
grep '^  "written": true$' $WORK/report.json

# A project that the output does not hold yet: nothing kept, nor listed.
status 1 okdp-compile --repository $WORK/tree -o $WORK/fresh --target flux --partial
exists $WORK/fresh/projects/data/instances/data-db/helmrelease.yaml
! exists $WORK/fresh/projects/demo
cmp $WORK/fresh/projects/kustomization.yaml $WORK/root-data.yaml

# A failure of the tree writes nothing, --partial or not.
status 1 okdp-compile --repository $WORK/tree -o $WORK/none --target flux --flux-source okdp --partial
! exists $WORK/none

# --check writes nothing: no --partial.
status 1 okdp-compile --repository $WORK/tree --check --partial
stderr '^error: --check writes nothing: no --partial$'

-- zero.yaml --
replicas: 0
-- three.yaml --
replicas: 3
-- root.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - data
  - demo
-- root-data.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - data
-- tree/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/web/1.0.0/config.schema.json --
{"properties": {"replicas": {"type": "integer", "minimum": 1, "default": 1}}}
-- tree/catalog/web/1.0.0/values.cel.yaml --
web:
  replicas: ${{ values.replicas }}
-- tree/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/demo/instances/web/config.yaml --
replicas: 2
-- tree/projects/demo/instances/ok/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/data/instances/db/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/data/instances/db/config.yaml --
replicas: 1
