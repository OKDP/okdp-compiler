# global.okdp.network.policy: each project's namespace but the platform's
# own (ops) gets a NetworkPolicy, ingress denied but from the namespace,
# the platform's ingress namespaces and the namespaces whose claims its
# instances provide: data, the provider of demo's claim, is reached by
# demo; demo by nobody else. Both targets write it alike, Flux's
# kustomization.yaml lists it.
status 0 okdp-compile --repository $WORK/tree -o $WORK/out --target argocd --repo-url https://git.example.org/out.git
cmp $WORK/out/projects/data/project/network-policy.yaml $WORK/data.yaml
cmp $WORK/out/projects/demo/project/network-policy.yaml $WORK/demo.yaml
! exists $WORK/out/projects/ops/project/network-policy.yaml
status 0 okdp-compile --repository $WORK/tree -o $WORK/flux --target flux
cmp $WORK/flux/projects/data/project/network-policy.yaml $WORK/data.yaml
grep -count=1 '^  - network-policy.yaml$' $WORK/flux/projects/data/project/kustomization.yaml

# --partial, data kept (an instance of it refused): its policy written of
# today's settings, demo, whose claim it provides, still among its
# claimers.
mkdir $WORK/tree/projects/data/instances/y
cp $WORK/broken.yaml $WORK/tree/projects/data/instances/y/instance.yaml
cp $WORK/bad.yaml $WORK/tree/projects/data/instances/y/config.yaml
cp $WORK/platform-monitoring.yaml $WORK/tree/platform.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target argocd --repo-url https://git.example.org/out.git --partial
stderr '^error: data: not written, an instance of it refused \(--partial\)'
cmp $WORK/out/projects/data/project/network-policy.yaml $WORK/data-monitoring.yaml

# Without the policy, none written.
cp $WORK/platform-off.yaml $WORK/tree/platform.yaml
rm $WORK/tree/projects/data/instances/y
status 0 okdp-compile --repository $WORK/tree -o $WORK/off --target argocd --repo-url https://git.example.org/out.git
! exists $WORK/off/projects/data/project/network-policy.yaml
! exists $WORK/off/projects/demo/project/network-policy.yaml

-- data.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: okdp-project
  namespace: "data"
  labels:
    okdp.io/project: "data"
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {}
    - from:
        - namespaceSelector:
            matchExpressions:
              - key: kubernetes.io/metadata.name
                operator: In
                values: ["ingress-nginx", "demo"]
-- data-monitoring.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: okdp-project
  namespace: "data"
  labels:
    okdp.io/project: "data"
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {}
    - from:
        - namespaceSelector:
            matchExpressions:
              - key: kubernetes.io/metadata.name
                operator: In
                values: ["ingress-nginx", "monitoring", "demo"]
-- demo.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: okdp-project
  namespace: "demo"
  labels:
    okdp.io/project: "demo"
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {}
    - from:
        - namespaceSelector:
            matchExpressions:
              - key: kubernetes.io/metadata.name
                operator: In
                values: ["ingress-nginx"]
-- broken.yaml --
service: pg
version: 1.0.0
-- bad.yaml --
size: 0
-- platform-monitoring.yaml --
global:
  okdp:
    network: {policy: true, ingressNamespaces: [ingress-nginx, monitoring]}
    policy: {privileged: [ops]}
    provisioning:
      server:
        default: standard
        classes:
          standard: {provider: data/data-pg}
-- platform-off.yaml --
global:
  okdp:
    policy: {privileged: [ops]}
    provisioning:
      server:
        default: standard
        classes:
          standard: {provider: data/data-pg}
-- tree/platform.yaml --
global:
  okdp:
    network: {policy: true, ingressNamespaces: [ingress-nginx]}
    policy: {privileged: [ops]}
    provisioning:
      server:
        default: standard
        classes:
          standard: {provider: data/data-pg}
-- tree/contracts/server.schema.json --
{"properties": {"host": {"type": "string"}}, "required": ["host"]}
-- tree/catalog/pg/1.0.0/Chart.yaml --
apiVersion: v2
name: pg
version: 1.0.0
dependencies:
  - {name: postgresql, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/pg/1.0.0/config.schema.json --
{"properties": {"size": {"type": "integer", "minimum": 1, "default": 1}}}
-- tree/catalog/pg/1.0.0/okdp.yaml --
provisions: [server]
provides:
  - $for: c in claims
    $each: {contract: server, name: '${{ c.id }}', values: {host: '${{ release.name }}-rw.${{ release.namespace }}.svc'}}
-- tree/catalog/app/1.0.0/Chart.yaml --
apiVersion: v2
name: app
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/app/1.0.0/config.schema.json --
{"properties": {"db": {"type": ["string", "object"], "default": {}, "x-okdp-connection-ref": {"contract": "server", "provision": true}}}}
-- tree/catalog/app/1.0.0/values.cel.yaml --
app:
  db: ${{ values.db.host }}
-- tree/projects/data/instances/pg/instance.yaml --
service: pg
version: 1.0.0
-- tree/projects/demo/instances/app/instance.yaml --
service: app
version: 1.0.0
-- tree/projects/ops/instances/x/instance.yaml --
service: pg
version: 1.0.0
