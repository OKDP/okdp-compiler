# The platform's secret store: a connection of a project or an instance
# reads the keys of its namespace only. demo-app's connections.yaml names
# the key of a claim another namespace provides: refused, nothing
# written; demo-own's names one under demo/, finance's project.yaml one
# under finance/: each read by an ExternalSecret of the instance; the
# platform's, platform/datalake, by every instance that references it.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/stolen -o $WORK/none
stderr '^error: demo/demo-app: connections.stolen: connection "stolen": secretRef.remoteKey "finance/finance.ledger.database": a key of the platform''s secret store a project may not read: a connection above level 0 \(level 2\) names a key under "demo/", its namespace; the platform''s keys are read through the platform''s connections \(level 0\)$'
! exists $WORK/none
status 0 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/own -o $WORK/out
! stdout .
! stderr .
grep -count=2 'key: demo/own' $WORK/out/projects/demo/instances/demo-own/okdp.objects.yaml
grep -count=2 'key: finance/ledger' $WORK/out/projects/finance/instances/finance-ledger/okdp.objects.yaml
grep -count=2 'key: platform/datalake' $WORK/out/projects/finance/instances/finance-reports/okdp.objects.yaml

# No project is named platform: platform/ is the segment of the
# platform's keys, which its connections read and a path-based store
# lets every namespace read, and a namespace writes its own segment.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/reserved -o $WORK/none
stderr '^error: platform/platform-app: Inputs.Namespace "platform": the namespace is reserved: platform/ holds the platform''s keys of the secret store, which no project writes$'
! exists $WORK/none

# A provider names the Secret of a claim's credentials (secretRef.name),
# whose copy in each claimer's namespace is <release>-<name>: x.yy-credentials
# makes demo-app's demo-app-x.yy-credentials, the Secret of the connection
# yy of demo-app-x, <release>.<connection>-credentials. Two objects of a
# namespace that write one Secret refuse both instances, each error naming
# the other.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/platform --repository $WORK/forged -o $WORK/none
stderr '^error: demo/demo-app: Secret "demo-app-x.yy-credentials" of namespace demo is written by ExternalSecret demo-app-x.yy-credentials of demo-app and ExternalSecret demo-app-x.yy-credentials of demo-app-x: two objects may not write one Secret$'
stderr '^error: demo/demo-app-x: Secret "demo-app-x.yy-credentials" of namespace demo is written by ExternalSecret demo-app-x.yy-credentials of demo-app and ExternalSecret demo-app-x.yy-credentials of demo-app-x: two objects may not write one Secret$'
! exists $WORK/none

-- lib/contracts/s3.schema.json --
{"properties": {"bucket": {"type": "string"}, "accessKey": {"type": "string", "x-okdp-secret": true}, "secretKey": {"type": "string", "x-okdp-secret": true}}, "required": ["bucket"]}
-- lib/catalog/app/1.0.0/Chart.yaml --
apiVersion: v2
name: app
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- lib/catalog/app/1.0.0/config.schema.json --
{"properties": {"storage": {"type": "string", "x-okdp-connection-ref": {"contract": "s3", "require": {"required": ["secretRef"]}}}}}
-- lib/catalog/app/1.0.0/values.cel.yaml --
app:
  bucket: ${{ values.storage.bucket }}
  credentials: ${{ values.storage.secretRef.name }}
-- platform/platform.yaml --
global:
  okdp:
    secrets:
      store: okdp-secrets
connections:
  datalake:
    contract: s3
    bucket: datalake
    secretRef: {remoteKey: platform/datalake}
-- stolen/projects/demo/instances/app/instance.yaml --
service: app
version: 1.0.0
-- stolen/projects/demo/instances/app/config.yaml --
storage: stolen
-- stolen/projects/demo/instances/app/connections.yaml --
connections:
  stolen:
    contract: s3
    bucket: ledger
    secretRef: {remoteKey: finance/finance.ledger.database}
-- own/projects/demo/instances/own/instance.yaml --
service: app
version: 1.0.0
-- own/projects/demo/instances/own/config.yaml --
storage: own
-- own/projects/demo/instances/own/connections.yaml --
connections:
  own:
    contract: s3
    bucket: own
    secretRef: {remoteKey: demo/own}
-- own/projects/finance/project.yaml --
connections:
  ledger:
    contract: s3
    bucket: ledger
    secretRef: {remoteKey: finance/ledger}
-- own/projects/finance/instances/ledger/instance.yaml --
service: app
version: 1.0.0
-- own/projects/finance/instances/ledger/config.yaml --
storage: ledger
-- own/projects/finance/instances/reports/instance.yaml --
service: app
version: 1.0.0
-- own/projects/finance/instances/reports/config.yaml --
storage: datalake
-- reserved/projects/platform/instances/app/instance.yaml --
service: app
version: 1.0.0
-- reserved/projects/platform/instances/app/config.yaml --
storage: datalake
-- forged/contracts/database.schema.json --
{"x-okdp-contract": "database", "properties": {"host": {"type": "string"}, "password": {"type": "string", "x-okdp-secret": true}}, "required": ["host"], "x-okdp-claim": {"type": "object", "additionalProperties": false}}
-- forged/catalog/pg/1.0.0/Chart.yaml --
apiVersion: v2
name: pg
version: 1.0.0
dependencies:
  - {name: pg, repository: https://charts.example.org, version: 1.0.0}
-- forged/catalog/pg/1.0.0/okdp.yaml --
provisions: [database]
provides:
  - $for: c in claims
    $each:
      contract: database
      name: ${{ c.id }}
      values: {host: h}
      secretRef: {name: x.yy-credentials}
      secret: {generate: [{key: password}]}
-- forged/catalog/db-app/1.0.0/Chart.yaml --
apiVersion: v2
name: db-app
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- forged/catalog/db-app/1.0.0/config.schema.json --
{"properties": {"database": {"type": ["string", "object"], "x-okdp-connection-ref": {"contract": "database", "provision": true, "require": {"required": ["secretRef"]}}}}}
-- forged/catalog/db-app/1.0.0/values.cel.yaml --
app:
  credentials: ${{ values.database.secretRef.name }}
-- forged/projects/data/instances/pg/instance.yaml --
service: pg
version: 1.0.0
claimers: [demo]
-- forged/projects/demo/instances/app/instance.yaml --
service: db-app
version: 1.0.0
-- forged/projects/demo/instances/app/config.yaml --
database: {provider: data/pg}
-- forged/projects/demo/instances/app-x/instance.yaml --
service: db-app
version: 1.0.0
-- forged/projects/demo/instances/app-x/config.yaml --
database: yy
-- forged/projects/demo/instances/app-x/connections.yaml --
connections:
  yy:
    contract: database
    host: db.example.org
    secretRef: {remoteKey: demo/yy}
