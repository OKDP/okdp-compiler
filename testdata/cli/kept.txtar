# --partial, the projects kept: data-x refused keeps data; demo-app, which
# compiled, depends on data-pg, whose output is not written: demo kept
# too, said so, its report status skipped; solo written. Then a release of
# a kept project's output that a project written has too, and a symbolic
# link in a kept project's output: nothing written. Last, a release name
# two projects share keeps both, the others written.
status 0 okdp-compile --repository $WORK/tree -o $WORK/out --target flux
cp $WORK/zero.yaml $WORK/tree/projects/data/instances/x/config.yaml
cp $WORK/three.yaml $WORK/tree/projects/solo/instances/s/config.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial --report $WORK/report.json
stderr '^error: data/data-x: values don''t meet'
stderr '^error: demo/demo-app: it depends on data/data-pg, of the project data, whose output is kept$'
stderr '^error: data: not written, an instance of it refused \(--partial\): .*out/projects/data/ kept as it is, its namespace, identity and roles of today''s settings$'
stderr '^error: demo: not written, an instance of it refused \(--partial\): .*out/projects/demo/ kept as it is, its namespace, identity and roles of today''s settings$'
grep 'replicas: 3' $WORK/out/projects/solo/instances/solo-s/instance.values.yaml
cmp $WORK/out/projects/kustomization.yaml $WORK/root.yaml
grep -count=1 '"status": "refused"' $WORK/report.json
grep -count=2 '"status": "skipped"' $WORK/report.json
grep -count=1 '"status": "compiled"' $WORK/report.json

# A release solo-s in the output kept of demo: solo-s of solo would share
# its HelmRelease; nothing written.
mkdir $WORK/out/projects/demo/instances/solo-s
cp $WORK/zero.yaml $WORK/out/projects/demo/instances/solo-s/Chart.yaml
cp $WORK/one.yaml $WORK/tree/projects/solo/instances/s/config.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial
stderr '^error: release "solo-s" is in namespaces "demo" and "solo": the HelmReleases of okdp-releases need distinct names$'
grep 'replicas: 3' $WORK/out/projects/solo/instances/solo-s/instance.values.yaml
rm $WORK/out/projects/demo/instances/solo-s

# A symbolic link in the output of a kept project is not followed: refused,
# nothing written.
symlink $WORK/out/projects/demo/instances/demo-app/link.yaml -> $WORK/secret.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial
stderr '^error: the output of the project kept demo: .*projects/demo/instances/demo-app/link.yaml: a symbolic link, not followed$'
grep 'replicas: 3' $WORK/out/projects/solo/instances/solo-s/instance.values.yaml
rm $WORK/out/projects/demo/instances/demo-app/link.yaml

# web/a-b and web-a/b, both of the release web-a-b, which their
# HelmReleases would share: without --partial, each refused, nothing
# written; with it, web and web-a kept, refused in the report, neither
# in the output yet: nothing of them written; data, demo and solo written.
cp $WORK/one.yaml $WORK/tree/projects/data/instances/x/config.yaml
mkdir $WORK/tree/projects/web/instances/a-b $WORK/tree/projects/web-a/instances/b
cp $WORK/tree/projects/solo/instances/s/instance.yaml $WORK/tree/projects/web/instances/a-b/instance.yaml
cp $WORK/tree/projects/solo/instances/s/instance.yaml $WORK/tree/projects/web-a/instances/b/instance.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux
stderr '^error: web/web-a-b: release "web-a-b" is in namespaces "web" and "web-a": the HelmReleases of okdp-releases need distinct names$'
stderr '^error: web-a/web-a-b: release "web-a-b" is in namespaces "web" and "web-a": the HelmReleases of okdp-releases need distinct names$'
! stderr 'not written'
grep 'replicas: 3' $WORK/out/projects/solo/instances/solo-s/instance.values.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial --report $WORK/report.json
stderr '^error: web/web-a-b: release "web-a-b" is in namespaces "web" and "web-a": the HelmReleases of okdp-releases need distinct names$'
stderr '^error: web: not written, an instance of it refused \(--partial\): .*out/projects/web/ kept as it is, its namespace, identity and roles of today''s settings$'
stderr '^error: web-a: not written, an instance of it refused \(--partial\): .*out/projects/web-a/ kept as it is, its namespace, identity and roles of today''s settings$'
! stderr 'error: (data|demo|solo)[:/]'
grep 'replicas: 1' $WORK/out/projects/solo/instances/solo-s/instance.values.yaml
grep 'replicas: 1' $WORK/out/projects/data/instances/data-x/instance.values.yaml
exists $WORK/out/projects/demo/instances/demo-app/helmrelease.yaml
! exists $WORK/out/projects/web
! exists $WORK/out/projects/web-a
cmp $WORK/out/projects/kustomization.yaml $WORK/root.yaml
grep -count=2 '"status": "refused"' $WORK/report.json
grep -count=4 '"status": "compiled"' $WORK/report.json

-- zero.yaml --
replicas: 0
-- one.yaml --
replicas: 1
-- three.yaml --
replicas: 3
-- secret.yaml --
token: s3cr3t
-- root.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - data
  - demo
  - solo
-- tree/platform.yaml --
global:
  okdp:
    provisioning:
      server:
        default: standard
        classes:
          standard: {provider: data/data-pg}
-- tree/contracts/server.schema.json --
{"properties": {"host": {"type": "string"}, "name": {"type": "string"}}, "required": ["host"]}
-- tree/catalog/pg/1.0.0/Chart.yaml --
apiVersion: v2
name: pg
version: 1.0.0
dependencies:
  - {name: postgresql, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/pg/1.0.0/okdp.yaml --
provisions: [server]
provides:
  - $for: c in claims
    $each: {contract: server, name: '${{ c.id }}', values: {host: '${{ release.name }}-rw.${{ release.namespace }}.svc', name: '${{ c.id }}'}}
-- tree/catalog/app/1.0.0/Chart.yaml --
apiVersion: v2
name: app
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/app/1.0.0/config.schema.json --
{"properties": {"db": {"type": ["string", "object"], "default": {}, "x-okdp-connection-ref": {"contract": "server", "provision": true}}}}
-- tree/catalog/app/1.0.0/values.cel.yaml --
app:
  db: ${{ values.db.host }}/${{ values.db.name }}
-- tree/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/web/1.0.0/config.schema.json --
{"properties": {"replicas": {"type": "integer", "minimum": 1, "default": 1}}}
-- tree/catalog/web/1.0.0/values.cel.yaml --
web:
  replicas: ${{ values.replicas }}
-- tree/projects/data/instances/pg/instance.yaml --
service: pg
version: 1.0.0
-- tree/projects/data/instances/x/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/demo/instances/app/instance.yaml --
service: app
version: 1.0.0
-- tree/projects/solo/instances/s/instance.yaml --
service: web
version: 1.0.0
