# The parts of a tree no compile would read are refused rather than left
# unread: a stray file of an instance's directory (a values.yaml beside
# config.yaml); a catalogs.yaml whose menu lists a service of no catalog,
# a default version its catalog lacks. Every problem at once, the tree
# does not load, nothing written.
status 1 okdp-compile --repository $WORK/stray -o $WORK/files
! stdout .
stderr '^error: \S+/stray/catalogs.yaml: categories\[0\].services\[0\]: service "gone" is in no catalog \(catalog/gone/ of no repository\)$'
stderr '^\S+/stray/catalogs.yaml: categories\[0\].services\[1\].default: version "2.0.0" of service "web"'
stderr '^\S+/stray/projects/demo/instances/web/values.yaml: not a file of an instance, which holds instance.yaml, config.yaml and connections.yaml only: no compile reads it$'
! exists $WORK/files

# A connection is checked at its declaration, referenced or not: a
# project's, which no instance references, that misses a required field
# refuses every instance of the project, at connections.<name>; another
# project's instances compile.
status 1 okdp-compile --repository $WORK/conns --check
! stdout .
stderr '^error: demo/demo-web: connections.unused \(connection "unused"\): field "url" is required by the api contract$'
! stderr 'other/other-web'

# A project without instance has its declarations checked all the same,
# as an instance's compile checks its context's: a named claim of a
# class the platform does not define, whose request the
# contract's claim schema refuses or sets a key its class fixes, or of a
# connection's name, and a connection that does not hold; every problem
# at once, the project does not load (it is refused, not the
# tree). Declared well, it binds to nothing: the tree compiles.
status 1 okdp-compile --repository $WORK/empty --check
! stdout .
stderr '^error: \S+/empty/projects/idle/project.yaml: connections.broken \(connection "broken"\): field "url" is required by the api contract$'
cp $WORK/claims.yaml $WORK/empty/projects/idle/project.yaml
status 1 okdp-compile --repository $WORK/empty --check
stderr '^error: \S+/empty/projects/idle/project.yaml: claims.big: claim \(api\): the request does not meet the contract''s claim schema \(x-okdp-claim\):$'
stderr '^- at ''/size'': ''5G'' does not match pattern'
stderr '^error: \S+/empty/projects/idle/project.yaml: claims.fixed: claim: request.tier: set by the class gold \(global.okdp.provisioning.api.classes.gold\): remove it, or name another class$'
stderr '^error: \S+/empty/projects/idle/project.yaml: claims.nowhere: claim \(api\): class "silver" is not a class of api connections \(global.okdp.provisioning.api.classes\): gold$'
stderr '^error: \S+/empty/projects/idle/project.yaml: claims.same: a connection of that name too \(connections.same\)$'
cp $WORK/good.yaml $WORK/empty/projects/idle/project.yaml
status 0 okdp-compile --repository $WORK/empty --check

-- stray/catalogs.yaml --
categories:
  - title: Web
    services: [{name: gone}, {name: web, default: 2.0.0}]
-- stray/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- stray/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
-- stray/projects/demo/instances/web/values.yaml --
replicas: 3
-- conns/contracts/api.schema.json --
{"x-okdp-contract": "api", "properties": {"url": {"type": "string"}}, "required": ["url"]}
-- conns/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- conns/projects/demo/project.yaml --
connections:
  unused: {contract: api}
-- conns/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
-- conns/projects/other/instances/web/instance.yaml --
service: web
version: 1.0.0
-- empty/platform.yaml --
global:
  okdp:
    provisioning:
      api:
        default: gold
        classes:
          gold: {provider: data/api, request: {tier: gold}}
-- empty/contracts/api.schema.json --
{"x-okdp-contract": "api", "properties": {"url": {"type": "string"}}, "required": ["url"],
 "x-okdp-claim": {"properties": {"size": {"type": "string", "pattern": "^[0-9]+Gi$"}, "tier": {"type": "string"}}, "additionalProperties": false}}
-- empty/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- empty/projects/idle/project.yaml --
connections:
  broken: {contract: api}
-- empty/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
-- claims.yaml --
connections:
  same: {contract: api, url: https://same.example.org}
claims:
  big: {contract: api, request: {size: 5G}}
  fixed: {contract: api, request: {tier: silver}}
  nowhere: {contract: api, class: silver}
  same: {contract: api}
-- good.yaml --
connections:
  ok: {contract: api, url: https://ok.example.org}
claims:
  db: {contract: api, request: {size: 5Gi}}
