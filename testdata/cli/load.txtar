# A load problem of a project refuses that project, not the tree:
# a stray file in an instance's directory, an unknown key of instance.yaml,
# a project.yaml that does not parse. First every project compiles.
status 0 okdp-compile --repository $WORK/tree -o $WORK/out --target flux
cp $WORK/out/projects/demo/instances/demo-web/instance.values.yaml $WORK/web-before.yaml
cp $WORK/out/projects/lab/instances/lab-web/instance.values.yaml $WORK/lab-before.yaml

# demo gets a stray file, lab a key of instance.yaml that is none, data a
# change that compiles.
cp $WORK/stray.yaml $WORK/tree/projects/demo/instances/web/values.yaml
cp $WORK/unknown.yaml $WORK/tree/projects/lab/instances/web/instance.yaml
cp $WORK/three.yaml $WORK/tree/projects/data/instances/db/config.yaml

# Without --partial, every problem printed, each project's own, and
# nothing written.
status 1 okdp-compile --repository $WORK/tree -o $WORK/none --target flux
! stdout .
stderr '^error: \S+/tree/projects/demo/instances/web/values.yaml: not a file of an instance, which holds instance.yaml, config.yaml and connections.yaml only: no compile reads it$'
stderr '^error: \S+/tree/projects/lab/instances/web/instance.yaml: yaml: unmarshal errors:$'
stderr '^  line 3: field replicas not found: service, version and claimers only$'
! stderr 'struct'
! stderr 'data'
! exists $WORK/none

# --check says the same.
status 1 okdp-compile --repository $WORK/tree --check
stderr '^error: \S+/tree/projects/demo/instances/web/values.yaml: not a file of an instance'

# With --partial: data is written, demo and lab are kept as the output
# holds them, each said so; the report lists the problems.
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial --report $WORK/report.json
stderr '^error: \S+/tree/projects/demo/instances/web/values.yaml: not a file of an instance'
stderr '^error: demo: not written, it does not load \(--partial\): .*out/projects/demo/ kept as it is, its namespace, identity and roles of today''s settings$'
stderr '^error: lab: not written, it does not load \(--partial\): .*out/projects/lab/ kept as it is, its namespace, identity and roles of today''s settings$'
! stderr 'error: data'
grep 'replicas: 3' $WORK/out/projects/data/instances/data-db/instance.values.yaml
cmp $WORK/out/projects/demo/instances/demo-web/instance.values.yaml $WORK/web-before.yaml
cmp $WORK/out/projects/lab/instances/lab-web/instance.values.yaml $WORK/lab-before.yaml
exists $WORK/out/projects/demo/project/namespace.yaml
cmp $WORK/out/projects/kustomization.yaml $WORK/root.yaml
grep 'values.yaml: not a file of an instance' $WORK/report.json
grep '^  "written": true$' $WORK/report.json

# A project.yaml that does not parse: that project kept, its manifests as
# the output has them; the others written.
rm $WORK/tree/projects/demo/instances/web/values.yaml
cp $WORK/unknown.yaml $WORK/tree/projects/lab/instances/web/instance.yaml
cp $WORK/good-instance.yaml $WORK/tree/projects/lab/instances/web/instance.yaml
cp $WORK/broken.yaml $WORK/tree/projects/demo/project.yaml
cp $WORK/one.yaml $WORK/tree/projects/data/instances/db/config.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial
stderr '^error: \S+/tree/projects/demo/project.yaml: '
stderr '^error: demo: not written, it does not load \(--partial\): '
! stderr 'error: (lab|data)'
grep 'replicas: 1' $WORK/out/projects/data/instances/data-db/instance.values.yaml
cmp $WORK/out/projects/demo/instances/demo-web/instance.values.yaml $WORK/web-before.yaml
exists $WORK/out/projects/demo/project/namespace.yaml

# A project the output does not hold yet: nothing kept, nothing written.
status 1 okdp-compile --repository $WORK/tree -o $WORK/fresh --target flux --partial
stderr '^error: demo: not written, it does not load \(--partial\): '
exists $WORK/fresh/projects/data/instances/data-db/helmrelease.yaml
! exists $WORK/fresh/projects/demo

# A problem of the platform's parts still fails the tree, --partial or
# not: platform.yaml that does not parse, nothing written.
cp $WORK/good-project.yaml $WORK/tree/projects/demo/project.yaml
cp $WORK/broken.yaml $WORK/tree/platform.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/none --target flux --partial
stderr '^error: \S+/tree/platform.yaml: '
! exists $WORK/none
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial
cmp $WORK/out/projects/demo/instances/demo-web/instance.values.yaml $WORK/web-before.yaml

-- stray.yaml --
replicas: 3
-- unknown.yaml --
service: web
version: 1.0.0
replicas: 2
-- good-instance.yaml --
service: web
version: 1.0.0
-- broken.yaml --
[a
-- good-project.yaml --
description: The demo
-- one.yaml --
replicas: 1
-- three.yaml --
replicas: 3
-- root.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - data
  - demo
  - lab
-- tree/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/web/1.0.0/config.schema.json --
{"properties": {"replicas": {"type": "integer", "minimum": 1, "default": 1}}}
-- tree/catalog/web/1.0.0/values.cel.yaml --
web:
  replicas: ${{ values.replicas }}
-- tree/platform.yaml --
global: {}
-- tree/projects/demo/project.yaml --
description: The demo
-- tree/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/lab/instances/web/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/data/instances/db/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/data/instances/db/config.yaml --
replicas: 1
