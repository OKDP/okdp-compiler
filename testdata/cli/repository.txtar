# --repository: every instance of a tree compiled together, here two
# repositories, the contracts and packages apart from the project. demo-app
# references two outputs of demo-pg, a database and a server:
# listed first, it is compiled after demo-pg all the same. Its dependencies
# on stderr, after its namespace and release; a stale instance of the
# output directory removed.
mkdir $WORK/out/projects/demo/instances/demo-gone
cp $WORK/stale.yaml $WORK/out/projects/demo/instances/demo-gone/Chart.yaml
status 0 okdp-compile --repository $WORK/lib --repository $WORK/demo -o $WORK/out
! stdout .
cmp stderr $WORK/depends.txt
cmp $WORK/out/projects/demo/instances/demo-app/instance.values.yaml $WORK/values.txt
exists $WORK/out/projects/demo/instances/demo-pg/okdp.info.yaml
! exists $WORK/out/projects/demo/instances/demo-gone
! exists $WORK/out/projects/demo/instances/demo-app/helmrelease.yaml

# --target flux: the HelmReleases, demo-app's waiting for demo-pg; the
# Kustomizations.
status 0 okdp-compile --repository $WORK/lib --repository $WORK/demo -o $WORK/flux --target flux --path-prefix deploy
cmp $WORK/flux/projects/demo/instances/demo-app/helmrelease.yaml $WORK/helmrelease.txt
exists $WORK/flux/projects/demo/kustomization.yaml $WORK/flux/projects/demo/instances/demo-pg/kustomization.yaml

# --target argocd: the Applications, demo-app's in the wave after
# demo-pg's; --repo-url required.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/demo -o $WORK/argocd --target argocd
stderr '^error: --repo-url is required by --target argocd$'
! exists $WORK/argocd
status 0 okdp-compile --repository $WORK/lib --repository $WORK/demo -o $WORK/argocd --target argocd --repo-url https://git.example.org/okdp/deployments.git
grep 'argocd.argoproj.io/sync-wave: "1"' $WORK/argocd/projects/demo/instances/demo-app/application.yaml
grep 'argocd.argoproj.io/sync-wave: "0"' $WORK/argocd/projects/demo/instances/demo-pg/application.yaml

# --check: the same, nothing written, no dependency printed.
status 0 okdp-compile --repository $WORK/lib --repository $WORK/demo --check
! stdout .
! stderr .

# Instances that reference each other's outputs: neither compiles, each
# refusal names the other; status 1, nothing written.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/outputs -o $WORK/none
cmp stderr $WORK/outputs.txt
! exists $WORK/none

# A part of the tree in two repositories.
status 1 okdp-compile --repository $WORK/lib --repository $WORK/demo --repository $WORK/outputs -o $WORK/none
stderr '^error: project "demo" is in the repositories .*demo and .*outputs$'

-- stale.yaml --
stale: true
-- depends.txt --
demo/demo-app: depends on demo-pg (database, db)
demo/demo-app: depends on demo-pg (server pg-main, server)
-- values.txt --
# Code generated by okdp-compile. DO NOT EDIT.
app:
  db: demo-pg-db.demo.svc
  server: demo-pg-rw.demo.svc
-- outputs.txt --
error: demo/demo-a: server: "b-out" is not a connection, nor an output of an instance of the namespace (demo-b does not compile either: what it publishes is unknown)
error: demo/demo-b: server: "a-out" is not a connection, nor an output of an instance of the namespace (demo-a does not compile either: what it publishes is unknown)
-- helmrelease.txt --
# Code generated by okdp-compile. DO NOT EDIT.
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: "demo-app"
  namespace: okdp-releases
  labels:
    okdp.io/project: "demo"
    okdp.io/instance: "demo-app"
spec:
  interval: 10m
  releaseName: "demo-app"
  targetNamespace: "demo"
  storageNamespace: "demo"
  chart:
    spec:
      chart: "./deploy/projects/demo/instances/demo-app"
      reconcileStrategy: Revision
      sourceRef:
        kind: GitRepository
        name: okdp-gitops
        namespace: flux-system
  dependsOn:
    - name: "demo-pg"
  timeout: 15m
  install:
    createNamespace: true
    strategy:
      name: RetryOnFailure
      retryInterval: 2m
  upgrade:
    remediation:
      retries: 3
      strategy: rollback
  driftDetection:
    mode: enabled
  valuesFrom:
    - kind: ConfigMap
      name: "values-demo-app"
      valuesKey: instance.values.yaml
-- lib/contracts/database.schema.json --
{"properties": {"host": {"type": "string"}}, "required": ["host"]}
-- lib/contracts/server.schema.json --
{"properties": {"host": {"type": "string"}}, "required": ["host"]}
-- lib/catalog/app/1.0.0/Chart.yaml --
apiVersion: v2
name: app
version: 1.0.0
dependencies:
  - {name: app, repository: https://charts.example.org, version: 1.0.0}
-- lib/catalog/app/1.0.0/config.schema.json --
{"properties": {
  "db": {"type": "string", "x-okdp-connection-ref": {"contract": "database"}},
  "server": {"type": "string", "x-okdp-connection-ref": {"contract": "server"}},
  "name": {"type": "string"}}}
-- lib/catalog/app/1.0.0/okdp.yaml --
provides:
  - {contract: server, name: '${{ has(values.name) ? values.name : release.name }}', values: {host: '${{ release.name }}-rw.${{ release.namespace }}.svc'}}
  - {contract: database, values: {host: '${{ release.name }}-db.${{ release.namespace }}.svc'}}
-- lib/catalog/app/1.0.0/values.cel.yaml --
app:
  db: {$if: '${{ has(values.db) }}', $value: '${{ values.db.host }}'}
  server: {$if: '${{ has(values.server) }}', $value: '${{ values.server.host }}'}
-- demo/projects/demo/instances/demo-app/instance.yaml --
service: app
version: 1.0.0
-- demo/projects/demo/instances/demo-app/config.yaml --
db: demo-pg
server: pg-main
-- demo/projects/demo/instances/demo-pg/instance.yaml --
service: app
version: 1.0.0
-- demo/projects/demo/instances/demo-pg/config.yaml --
name: pg-main
-- outputs/projects/demo/instances/demo-a/instance.yaml --
service: app
version: 1.0.0
-- outputs/projects/demo/instances/demo-a/config.yaml --
name: a-out
server: b-out
-- outputs/projects/demo/instances/demo-b/instance.yaml --
service: app
version: 1.0.0
-- outputs/projects/demo/instances/demo-b/config.yaml --
name: b-out
server: a-out
