# A values.yaml that holds an expression: compiled all the same, status 0,
# the warning on stderr, once, and the outputs written.
mkdir $WORK/contracts
status 0 okdp-compile --package $WORK/hello --charts $WORK/charts --contracts $WORK/contracts --release demo-hello --namespace demo --context $WORK/platform.yaml -o $WORK/files
! stdout .
cmp stderr $WORK/warning.txt
grep '^  message: Hello from demo-hello$' $WORK/files/instance.values.yaml
exists $WORK/files/Chart.yaml $WORK/files/okdp.dependencies.yaml

# Named values.cel.yaml: no warning. Both files: an error, nothing written.
mv $WORK/hello/values.yaml $WORK/hello/values.cel.yaml
status 0 okdp-compile --package $WORK/hello --charts $WORK/charts --contracts $WORK/contracts --release demo-hello --namespace demo --context $WORK/platform.yaml -o $WORK/cel
! stderr .
cp $WORK/hello/values.cel.yaml $WORK/hello/values.yaml
status 1 okdp-compile --package $WORK/hello --charts $WORK/charts --contracts $WORK/contracts --release demo-hello --namespace demo --context $WORK/platform.yaml -o $WORK/both
stderr '^error: values.yaml and values.cel.yaml: a package has one of them$'
! exists $WORK/both

-- warning.txt --
warning: values.yaml holds expressions or directives (${{ }}, $-keys): name it values.cel.yaml
-- hello/Chart.yaml --
apiVersion: v2
name: hello
version: 1.0.0
dependencies:
  - {name: hello, repository: https://charts.example.org, version: 1.0.0}
-- hello/values.yaml --
hello:
  message: Hello from ${{ release.name }}
-- charts/charts.example.org/hello-1.0.0/hello/values.yaml --
message: Hello
-- charts/registry.example.org/okdp/okdp-objects-1.0.0/okdp-objects/values.yaml --
objects: []
-- platform.yaml --
global:
  okdp:
    charts:
      objects: {repository: oci://registry.example.org/okdp, chart: okdp-objects, version: 1.0.0}
