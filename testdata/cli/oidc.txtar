# The Secret an OAuth client is written to is one of its release's,
# <release>-...: the Job that registers the client writes it with a Role
# of the namespace, and would otherwise overwrite another instance's
# credentials (demo-db's). Refused in every mode, here OIDC unset;
# nothing written.
status 1 okdp-compile --repository $WORK/tree -o $WORK/files
! stdout .
stderr '^error: demo/demo-web: oidcClients\[0\]: secret "demo-db-credentials": the Secret the client is written to is one of the release''s, its name starts with "demo-web-"$'
! exists $WORK/files

-- tree/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/web/1.0.0/okdp.yaml --
oidcClients:
  - grantTypes: [client_credentials]
    secret: demo-db-credentials
-- tree/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
