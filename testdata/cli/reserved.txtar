# A namespace the platform reserves after a project holds it: with
# --partial the project's output is not kept, nor re-derived, in the
# platform's namespace: nothing of projects/openbao/ remains, said so.
# First openbao is a project like another, privileged.
cp $WORK/privileged.yaml $WORK/tree/platform.yaml
status 0 okdp-compile --repository $WORK/tree -o $WORK/out --target flux
exists $WORK/out/projects/openbao/project/namespace.yaml
exists $WORK/out/projects/openbao/instances/openbao-web/helmrelease.yaml
exists $WORK/out/projects/demo/instances/demo-web/helmrelease.yaml
grep 'openbao' $WORK/out/projects/kustomization.yaml

# Then the platform reserves it, privileged or not.
cp $WORK/reserved.yaml $WORK/tree/platform.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/none --target flux
! exists $WORK/none
stderr '^error: openbao/openbao-web: Inputs.Namespace "openbao": the namespace is reserved by the platform \(global.okdp.policy.reserved\)'

# --partial: demo written, openbao dropped: its Role, Namespace, access and
# HelmRelease gone, not in the root Kustomization either.
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial --report $WORK/report.json
stderr '^error: openbao/openbao-web: Inputs.Namespace "openbao": the namespace is reserved by the platform'
stderr '^error: openbao: dropped from the output \(--partial\): Inputs.Namespace "openbao": the namespace is reserved by the platform \(global.okdp.policy.reserved\)'
! stderr 'error: openbao: not written'
! exists $WORK/out/projects/openbao
exists $WORK/out/projects/demo/instances/demo-web/helmrelease.yaml
cmp $WORK/out/projects/kustomization.yaml $WORK/root.yaml
grep -count=1 '"status": "refused"' $WORK/report.json
grep -count=1 '"status": "compiled"' $WORK/report.json

# A name the compiler itself reserves, held by an output written before it
# did (a previous release of the compiler): dropped alike, the tree does
# not fail. Here an output that holds kube-system, of a project the tree
# still has.
mkdir $WORK/tree/projects/kube-system/instances/web
cp $WORK/tree/projects/demo/instances/web/instance.yaml $WORK/tree/projects/kube-system/instances/web/instance.yaml
mkdir $WORK/out/projects/kube-system/instances/kube-system-web
cp $WORK/chart.yaml $WORK/out/projects/kube-system/instances/kube-system-web/Chart.yaml
cp $WORK/out/projects/demo/project/kustomization.yaml $WORK/out/projects/kube-system/kustomization.yaml
status 1 okdp-compile --repository $WORK/tree -o $WORK/out --target flux --partial
stderr '^error: kube-system: dropped from the output \(--partial\): '
! exists $WORK/out/projects/kube-system
exists $WORK/out/projects/demo/instances/demo-web/helmrelease.yaml
! exists $WORK/out/projects/openbao

-- privileged.yaml --
global:
  okdp:
    policy:
      privileged: [openbao]
-- reserved.yaml --
global:
  okdp:
    policy:
      privileged: [openbao]
      reserved: [openbao]
-- chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
-- root.yaml --
# Code generated by okdp-compile. DO NOT EDIT.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - demo
-- tree/platform.yaml --
global: {}
-- tree/catalog/web/1.0.0/Chart.yaml --
apiVersion: v2
name: web
version: 1.0.0
dependencies:
  - {name: web, repository: https://charts.example.org, version: 1.0.0}
-- tree/catalog/web/1.0.0/okdp.yaml --
{}
-- tree/projects/openbao/instances/web/instance.yaml --
service: web
version: 1.0.0
-- tree/projects/demo/instances/web/instance.yaml --
service: web
version: 1.0.0
