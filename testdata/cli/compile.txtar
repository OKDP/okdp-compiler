# A compile: status 0, nothing printed, the example's outputs written: the
# instance as one chart.
env OKDP_CHARTS=examples/02_advanced/input/charts OKDP_CONTRACTS=examples/02_advanced/input/contracts
status 0 okdp-compile --package examples/02_advanced/input/service --release demo-webapp --namespace demo --platform examples/02_advanced/input/platform.yaml -f examples/02_advanced/input/config.yaml -o $WORK/files
! stdout .
! stderr .
cmp $WORK/files/Chart.yaml examples/02_advanced/output-no-dcr/Chart.yaml
cmp $WORK/files/instance.values.yaml examples/02_advanced/output-no-dcr/instance.values.yaml

# --project: a project file between the platform's and the instance's, with
# --mkdag; one that changes a platform value fails, nothing written.
status 0 okdp-compile --package examples/03_full/input/service --charts examples/03_full/input/charts --contracts examples/03_full/input/contracts --release demo-workspace --namespace demo --platform examples/03_full/input/platform.yaml --project examples/03_full/input/demo.yaml -f examples/03_full/input/config.yaml -o $WORK/full --mkdag
! stdout .
! stderr .
cmp $WORK/full/instance.values.yaml examples/03_full/output/instance.values.yaml
cmp $WORK/full/okdp.dependencies.yaml examples/03_full/output/okdp.dependencies.yaml
status 1 okdp-compile --package examples/02_advanced/input/service --release demo-webapp --namespace demo --platform examples/02_advanced/input/platform.yaml --project testdata/project/redefines-platform-connection.yaml -f examples/02_advanced/input/config.yaml -o $WORK/project
stderr '^error: project layer 1: connections.platform-db is set by the platform \(--platform, Inputs.Platform\): a project adds values, it does not change the platform.s$'
! exists $WORK/project
