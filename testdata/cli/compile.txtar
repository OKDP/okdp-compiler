# A tree compiled: status 0, each instance's files written under
# projects/<namespace>/instances/<release>/, the instance as one chart and
# what it publishes, no objects file without objects; on stderr, each
# claim's binding, then the instances each depends on, one line each, by
# parameter path.
status 0 okdp-compile --repository examples/02_advanced/input/db -o $WORK/files
! stdout .
cmp stderr $WORK/webapp.txt
cmp $WORK/files/projects/demo/instances/demo-webapp/Chart.yaml examples/02_advanced/output/projects/demo/instances/demo-webapp/Chart.yaml
cmp $WORK/files/projects/demo/instances/demo-webapp/instance.values.yaml examples/02_advanced/output/projects/demo/instances/demo-webapp/instance.values.yaml
cmp $WORK/files/projects/demo/instances/demo-webapp/okdp.info.yaml examples/02_advanced/output/projects/demo/instances/demo-webapp/okdp.info.yaml
! exists $WORK/files/projects/demo/instances/demo-webapp/okdp.objects.yaml $WORK/files/projects/demo/instances/demo-webapp/templates

# The context by level: platform.yaml (0), the project's project.yaml (1),
# the instance's connections.yaml (2), then its config.yaml.
status 0 okdp-compile --repository examples/03_full/input/db -o $WORK/full
! stdout .
cmp stderr $WORK/workspace.txt
cmp $WORK/full/projects/demo/instances/demo-workspace/instance.values.yaml examples/03_full/output/projects/demo/instances/demo-workspace/instance.values.yaml
cmp $WORK/full/projects/demo/instances/demo-workspace/okdp.objects.yaml examples/03_full/output/projects/demo/instances/demo-workspace/okdp.objects.yaml
cmp $WORK/full/projects/demo/instances/demo-workspace/templates/okdp.yaml examples/03_full/output/projects/demo/instances/demo-workspace/templates/okdp.yaml

# A tree that reads no contract and depends on nothing: nothing printed,
# and an instance that publishes nothing has no okdp.info.yaml.
status 0 okdp-compile --repository examples/00_passthrough/input/db -o $WORK/echo
! stdout .
! stderr .
cmp $WORK/echo/projects/demo/instances/demo-echo/instance.values.yaml examples/00_passthrough/output/projects/demo/instances/demo-echo/instance.values.yaml
! exists $WORK/echo/projects/demo/instances/demo-echo/okdp.info.yaml

-- webapp.txt --
demo/demo-webapp: database: claim demo.demo-webapp.database (database) bound to demo/demo-db, the default class standard
demo/demo-webapp: depends on demo-db (database demo.demo-webapp.database, database)
-- workspace.txt --
demo/demo-workspace: catalogs[1].database: claim demo.marketing (database) bound to demo/demo-db, the default class standard
demo/demo-workspace: database: claim demo.demo-workspace.database (database) bound to demo/demo-db, the default class standard
demo/demo-workspace: depends on demo-db (database demo.marketing, catalogs[1].database)
demo/demo-workspace: depends on demo-db (database demo.demo-workspace.database, database)
demo/demo-workspace: depends on demo-alerts (http, notifications.webhook)
