{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A rule set: rules.yaml, at the root of its file system (LoadRules).",
  "additionalProperties": false,
  "required": ["apiVersion", "version", "tables", "checks", "schemas", "functions", "templates", "sections", "charts", "documents", "ownCharts", "labels", "names", "keepSync"],
  "properties": {
    "apiVersion": {"const": "okdp-compiler/rules.v1"},
    "version": {"type": "string", "minLength": 1},
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "mapping"],
      "properties": {"platform": {"type": "string", "minLength": 1}, "mapping": {"type": "string", "minLength": 1}}
    },
    "functions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"fragment": {"type": "string", "minLength": 1}, "document": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}}
      }
    },
    "templates": {
      "type": "object",
      "required": ["generatedSecret"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "sections": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "charts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "chart", "version"],
        "properties": {"repository": {"type": "string"}, "chart": {"type": "string"}, "version": {"type": "string"}}
      }
    },
    "documents": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "ownCharts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "chart", "list", "values"],
        "properties": {"section": {"type": "string"}, "chart": {"type": "string"}, "list": {"type": "string"}, "values": {"type": "string"}}
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialsSecret", "connectionSecret", "claimSecret", "credentialsLabel"],
      "properties": {
        "credentialsSecret": {"type": "string", "minLength": 1},
        "connectionSecret": {"type": "string", "minLength": 1},
        "claimSecret": {"type": "string", "minLength": 1},
        "credentialsLabel": {"type": "string", "minLength": 1}
      }
    },
    "keepSync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation", "value", "syncOptions", "options"],
      "properties": {
        "annotation": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "syncOptions": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "component", "common"],
      "properties": {
        "selector": {"type": "object", "additionalProperties": {"type": "string"}},
        "component": {"type": "string", "minLength": 1},
        "common": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "checks": {
      "type": "object",
      "description": "Each check's document, a file of the rule set.",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["values"],
        "properties": {
          "values": {"type": "array", "items": {"type": "string"}},
          "addFrom": {"type": "string", "minLength": 1, "description": "The path under global.okdp of a list the platform adds to the table."}
        }
      }
    }
  }
}
