{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A rule set: rules.yaml, at the root of its file system: the compiler's mandatory set, or one added to it (LoadRules). Each section is optional here: what the sets give together is checked when they are combined.",
  "additionalProperties": false,
  "required": ["apiVersion", "version"],
  "properties": {
    "apiVersion": {"const": "okdp-compiler/rules.v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "description": "The set's name: core for the mandatory set; required for a set added to it, a name no other set has. A tree requires a set by its name (global.okdp.ruleSets)."},
    "version": {"type": "string", "minLength": 1, "description": "The set's version, MAJOR.MINOR.PATCH with an optional -prerelease."},
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "description": "The schemas of the platform's settings and of a mapping. The first set that gives one gives the schema; a set added to it adds properties and $defs, and changes nothing the first gives.",
      "properties": {"platform": {"type": "string", "minLength": 1}, "mapping": {"type": "string", "minLength": 1}}
    },
    "scopes": {
      "type": "array",
      "description": "The documents that compute what a mapping sees as platform, names of documents, evaluated in order, the sets' in the order they are read.",
      "items": {"type": "string", "minLength": 1}
    },
    "functions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"fragment": {"type": "string", "minLength": 1}, "document": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}}
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "sections": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "charts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "chart", "version"],
        "properties": {"repository": {"type": "string"}, "chart": {"type": "string"}, "version": {"type": "string"}}
      }
    },
    "documents": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "ownObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "list", "objects"],
        "properties": {"section": {"type": "string"}, "list": {"type": "string"}, "objects": {"type": "string"}}
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialsSecret", "connectionSecret", "claimSecret", "credentialsLabel"],
      "properties": {
        "credentialsSecret": {"type": "string", "minLength": 1},
        "connectionSecret": {"type": "string", "minLength": 1},
        "claimSecret": {"type": "string", "minLength": 1},
        "credentialsLabel": {"type": "string", "minLength": 1}
      }
    },
    "keepSync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation", "value", "syncOptions", "options"],
      "properties": {
        "annotation": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "syncOptions": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "component", "common"],
      "properties": {
        "selector": {"type": "object", "additionalProperties": {"type": "string"}},
        "component": {"type": "string", "minLength": 1},
        "common": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "checks": {
      "type": "object",
      "description": "Each check's document, a file of the rule set.",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "tables": {
      "type": "object",
      "description": "Each table of the set, or values the set adds to an extensible table a set read before gives.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["values"],
            "properties": {
              "values": {"type": "array", "items": {"type": "string"}},
              "addFrom": {"type": "string", "minLength": 1, "description": "The path under global.okdp of a list the platform adds to the table."},
              "extensible": {"type": "boolean", "description": "A set read later may add values to the table (add)."}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["add"],
            "properties": {
              "add": {"type": "array", "items": {"type": "string"}, "description": "The values added to the extensible table of that name."}
            }
          }
        ]
      }
    },
    "hooks": {
      "type": "object",
      "description": "The documents the compiler calls at each hook, names of documents.",
      "additionalProperties": false,
      "properties": {
        "objects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "finalValues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
